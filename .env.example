# ====================================
# PDNS Manager – Umgebungsvariablen
# ====================================
# Kopiere diese Datei als .env und passe die Werte an:
#   cp .env.example .env
#
# WICHTIG:
# - Die .env wird NIE nach Git/GitHub hochgeladen (siehe .gitignore).
# - Trage hier echte Geheimnisse nur lokal ein. Auf einem produktiven Server
#   sollten alle Passwörter mit `openssl rand -base64 32` o. ä. erzeugt werden.
# - Das `install.sh`-Skript erzeugt die meisten Werte automatisch.

# ========================
# Datenbank (MariaDB)
# ========================
# PFLICHT: Beide Passwörter müssen gesetzt, lang (mind. 24 Zeichen) und zufällig sein.
# Erzeugen mit:  openssl rand -base64 32
# Bewusst leer gelassen: bleibt ein Wert leer, bricht `docker compose up` mit einer klaren
# Fehlermeldung ab, statt MariaDB mit einem öffentlich bekannten Platzhalter zu initialisieren.
DB_ROOT_PASSWORD=
DB_NAME=dns_manager
DB_USER=dns_admin
DB_PASSWORD=

# ========================
# PowerDNS Server (optional)
# ========================
# Format: name|url|api_key
# Mehrere Server mit Komma trennen: name1|url1|key1,name2|url2|key2
#
# Hinweis: Server können auch zur Laufzeit im Admin-Panel hinzugefügt werden.
# Die hier gesetzten Werte werden beim ersten Start einmalig in die Datenbank importiert.
PDNS_SERVERS=

# ========================
# App-Grundeinstellungen
# ========================
APP_NAME=PDNS Manager
# APP_VERSION wird ausschließlich aus der Datei VERSION im Projektroot gelesen.
LOG_LEVEL=info

# Standard-Sprache der Oberfläche
# DEFAULT_LANGUAGE=de

# Pfad auf dem HOST, in dem das Projekt liegt – wird unter „Einstellungen → Updates“ angezeigt.
# install.sh / setup.sh tragen den Wert automatisch ein.
# INSTALL_PATH=/home/user/dns-manager

# ========================
# Port-Bindung (Host)
# ========================
# Auf welcher Host-Adresse und welchem Host-Port das Panel erreichbar ist
# (compose.yaml: "${BIND_ADDR:-0.0.0.0}:${HOST_PORT:-5380}:8000").
# Hinter einem Reverse-Proxy auf demselben Host EMPFOHLEN: nur lokal binden, damit
# Port 5380 nicht öffentlich ist (eine Host-Firewall greift bei Docker-Ports nicht).
# Bitte HIER setzen statt die compose.yaml zu editieren – lokale Änderungen an
# versionierten Dateien lassen ./update.sh beim git checkout scheitern.
# BIND_ADDR=127.0.0.1
# HOST_PORT=5380

# ========================
# Sicherheit
# ========================
# JWT-Geheimnis für Session-Cookies. Empfohlen, aber keine Pflicht (compose startet auch ohne).
# Wenn leer, erzeugt das Backend einmalig einen Schlüssel und legt ihn im internen
# Daten-Volume (backend_data:/app/data) ab – bleibt über Neustarts erhalten, wird nie
# ausgeliefert; im Log erscheint eine Warnung.
# Erzeugung:  openssl rand -hex 64
JWT_SECRET_KEY=

# Schlüssel für die Verschlüsselung gespeicherter Geheimnisse (ab 3.0):
# PowerDNS-API-Keys, SMTP-Passwort, Captcha-Secret, Webhook-Secrets und -URLs, 2FA-Geheimnisse
# (und OIDC/LDAP-Secrets, Metrik-Token) liegen damit nur verschlüsselt in der Datenbank.
# Erzeugung:  openssl rand -base64 32 | tr '+/' '-_'
# Leer = das Backend erzeugt beim ersten Start einen Schlüssel in /app/data/.secret_key
#        (Volume backend_data) und warnt im Log.
# WICHTIG: Ohne diesen Schlüssel sind die Geheimnisse aus einem DB-Backup NICHT lesbar.
#          .env bzw. Schlüsseldatei getrennt vom DB-Dump sichern. Nicht einfach ändern –
#          zum Wechseln den alten Wert nach SECRET_ENCRYPTION_KEY_PREVIOUS verschieben.
SECRET_ENCRYPTION_KEY=
# Alte Schlüssel (Komma-getrennt), nur zum Entschlüsseln während einer Rotation. Nach dem
# nächsten Start ist alles mit SECRET_ENCRYPTION_KEY verschlüsselt; danach entfernen
# (Einstellungen → Sicherheit zeigt, ob sie noch gebraucht werden).
# SECRET_ENCRYPTION_KEY_PREVIOUS=
# Optional: Schlüssel aus einer Datei lesen (z. B. Docker-Secret). Die Datei muss existieren.
# SECRET_ENCRYPTION_KEY_FILE=/run/secrets/pdns_manager_secret_key

# Initiales Admin-Passwort (nur beim allerersten Start verwendet).
# Wenn leer, generiert das Backend ein Zufallspasswort und legt es in
# /app/.initial-admin-password (nur einmal lesbar) ab + im Container-Log.
# INITIAL_ADMIN_PASSWORD=

# Selbst-Registrierung über die /setup-Seite zulassen?
# Nur sinnvoll, wenn du das Setup zum ersten Mal durchläufst.
# Nach Anlage des ersten Admins wird die Registrierung automatisch deaktiviert.
ENABLE_REGISTRATION=false

# ========================
# Auth-Cookies
# ========================
# Setze AUTH_COOKIE_SECURE=true, sobald du HTTPS nutzt (Reverse-Proxy mit TLS).
# Für reinen lokalen Test über http://localhost darf der Wert „false“ bleiben.
AUTH_COOKIE_SECURE=false
# „lax“ ist sinnvoll, wenn Frontend und Backend unter dem gleichen Origin liegen
# (Standard-Setup). Für getrennte Domains musst du „none“ + AUTH_COOKIE_SECURE=true setzen.
AUTH_COOKIE_SAMESITE=lax

# ========================
# CORS / Web-Sicherheit
# ========================
# Komma-getrennte Liste erlaubter Origins für Cross-Origin-Anfragen, z. B.:
#   ALLOWED_ORIGINS=https://dns.example.com,https://intern.example.com
# Leer = kein Cross-Origin (empfohlen, wenn die SPA vom gleichen Backend gehostet wird).
ALLOWED_ORIGINS=

# OpenAPI-/Swagger-/ReDoc-UI öffentlich verfügbar machen?
# Standard: AUS, damit die API-Struktur nicht ungewollt einsehbar ist.
DOCS_ENABLED=false

# Ausgehende Webhooks blockieren standardmäßig localhost/private/internal IPs
# (SSRF-Schutz). Nur auf true setzen, wenn interne Webhook-Ziele bewusst erlaubt sind.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# Hintergrund-Aufgaben: Webhook-Zustellung (Warteschlange mit Wiederholungen) und die
# stündliche Bereinigung des Audit-Logs (Aufbewahrungsfrist im Audit-Log einstellbar).
# false = Webhook-Ereignisse werden nur in der Datenbank gesammelt und NICHT gesendet
# (z. B. während einer Wartung oder in einem zweiten Container). Standard: true.
BACKGROUND_WORKERS_ENABLED=true

# Hinter einem Reverse-Proxy (TLS-Terminierung) die echte Client-IP aus
# X-Forwarded-For / X-Real-IP übernehmen – wichtig für korrektes Login-Rate-Limit
# und aussagekräftige Audit-Logs. NUR aktivieren, wenn dieses Backend ausschließlich
# über den vertrauenswürdigen Proxy erreichbar ist (Port nicht öffentlich), sonst
# könnten diese Header gefälscht werden.
TRUST_PROXY_HEADERS=false
# Anzahl vertrauenswürdiger Proxys vor dem Backend: 1 = nur dein Reverse-Proxy (nginx,
# Caddy, Traefik, cloudflared), 2 = z. B. Cloudflare-Proxy VOR deinem nginx. Ausgewertet
# wird der entsprechende Eintrag von rechts in X-Forwarded-For; alles links davon kann
# der Client selbst schreiben und wird ignoriert.
TRUSTED_PROXY_HOPS=1

# Content-Security-Policy: ist standardmäßig mit einem sicheren Wert AKTIV (deckt die
# SPA, die Captcha-Provider Turnstile/hCaptcha/reCAPTCHA und den GitHub-Versionscheck
# (nur Admins) ab). Zum Anpassen oder Deaktivieren CONTENT_SECURITY_POLICY im Backend-
# Service der compose.yaml setzen (leerer Wert = Header aus). reCAPTCHA braucht ggf.
# 'unsafe-eval'. Ein selbst gesetzter Wert bleibt bei Updates unverändert.
# CONTENT_SECURITY_POLICY=

# ========================
# Monitoring (Prometheus)
# ========================
# Der Endpunkt /metrics ist standardmäßig AUS. Normalerweise wird er im Panel unter
# Einstellungen → Monitoring aktiviert (Token wird dort erzeugt und verschlüsselt gespeichert).
# Alternativ hier einen festen Scrape-Token setzen (mind. 24 Zeichen, z. B. `openssl rand -hex 32`):
# dann ist /metrics aktiv und die Panel-Einstellung gesperrt. Prometheus sendet ihn als
# "Authorization: Bearer <token>". /metrics im Reverse-Proxy nicht öffentlich freigeben!
METRICS_TOKEN=

# ========================
# Passkeys / WebAuthn (passwortlose Anmeldung)
# ========================
# Passkeys funktionieren OHNE Konfiguration: die Domain wird automatisch aus dem
# Browser-Aufruf abgeleitet (localhost wie auch deine echte Domain).
# WICHTIG: Passkeys brauchen HTTPS – Ausnahme ist nur http://localhost zum Testen.
#
# Für Produktion EMPFOHLEN: feste Domain setzen (ohne https:// und ohne Port),
# damit registrierte Passkeys eindeutig an diese Domain gebunden sind. Beispiel:
#   WEBAUTHN_RP_ID=dns.example.com
# Hinweis: Wird die RP-ID später geändert, sind bereits registrierte Passkeys ungültig.
WEBAUTHN_RP_ID=
# Anzeigename im Browser-Dialog (leer = APP_NAME).
WEBAUTHN_RP_NAME=
# Erlaubte Origins (mit https://, Komma-getrennt). PFLICHT, sobald WEBAUTHN_RP_ID nicht
# exakt dem Host des Panels entspricht (z. B. RP_ID=example.com, Panel auf dns.example.com):
#   WEBAUTHN_ORIGIN=https://dns.example.com
# Wird ausserdem als Fallback fuer die App-Basis-URL (Passwort-Reset-Links) genutzt.
WEBAUTHN_ORIGIN=

# ========================
# SSO (OIDC / LDAP)
# ========================
# Die Konfiguration erfolgt im Panel (Einstellungen → Anmeldung / SSO), nicht hier.
# Nur für Testumgebungen: unverschlüsselte Verbindungen zum Anmeldedienst erlauben
# (http://-Issuer, LDAP ohne TLS bzw. ohne Zertifikatsprüfung). In Produktion NIE setzen.
SSO_ALLOW_INSECURE=false

# ========================
# Cookie-Lebensdauer
# ========================
# Maximale Login-Dauer in Sekunden (Default: 30 Tage = 2592000 s). Die Laufzeit des
# Session-Tokens (JWT) folgt automatisch diesem Wert (Sekunden / 60), solange
# JWT_EXPIRE_MINUTES nicht explizit gesetzt ist – Letzteres reicht die compose.yaml
# nicht durch und wäre nur über `environment:` im Backend-Service setzbar.
# Mit SSO (OIDC/LDAP) empfohlen: 8–24 Stunden (28800–86400), damit eine im Anmeldedienst
# gesperrte Person nicht wochenlang angemeldet bleibt (Sofort-Sperre: Benutzer im Panel deaktivieren).
# AUTH_COOKIE_MAX_AGE=2592000
